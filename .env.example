NODE_ENV=production
HOST=127.0.0.1
PORT=3105

# Crie um banco e usuário exclusivos na instância PostgreSQL já existente.
DATABASE_URL=postgresql://whatsapp_observer:change-this-password@127.0.0.1:5432/whatsapp_observer

ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# O webhook do Evolution usa um token longo na URL. O WAHA valida HMAC-SHA512.
EVOLUTION_WEBHOOK_TOKEN=replace-with-a-long-random-token
WAHA_HMAC_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WAHA_API_URL=http://127.0.0.1:3201
WAHA_API_KEY=
WAHA_SESSION=observer

LINEAR_API_KEY=
LINEAR_MAX_ATTEMPTS=12
LINEAR_FILE_UPLOAD_TIMEOUT_MS=300000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_TIMEOUT_MS=300000

# Caminhos permitidos para análise. Separe múltiplos caminhos por vírgula.
REPOSITORY_ROOTS=/srv/repositories
CODEX_CLI=codex
CODEX_MODEL=gpt-6-luna
CODEX_INTERPRETATION_TIMEOUT_MS=240000
CODEX_TIMEOUT_MS=600000
CODEX_MAX_ATTEMPTS=5

# ffmpeg continua necessário para extrair áudio e quadros de vídeos.
FFMPEG_CLI=ffmpeg
FFPROBE_CLI=ffprobe

# O debounce usa o horário de recebimento no servidor, nunca o timestamp WhatsApp.
BATCH_IDLE_MS=90000
BATCH_MAX_WAIT_MS=300000
BATCH_MAX_MESSAGES=30
BATCH_MAX_ATTEMPTS=8
MAX_PARALLEL_BATCHES=2
CODEX_CONCURRENCY=1
REPOSITORY_SYNC_INTERVAL_MS=300000
WORKER_POLL_MS=1000
MESSAGE_RETENTION_DAYS=365
MAX_AUDIO_BYTES=25000000
MAX_VIDEO_BYTES=50000000
MAX_MEDIA_BYTES=25000000
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_MAX_FRAMES_PER_MESSAGE=6
VIDEO_MAX_FRAMES_PER_BATCH=12
VIDEO_PROCESSING_TIMEOUT_MS=120000
